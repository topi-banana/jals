/target
/jals-playground/dist
# Prebuilt `jals` binary vendored by the npm/bun launcher at install/first run.
/npm/vendor
# Generated golden corpora, one per reference formatter (derivatives of GPL'd OpenJDK
# sources — do not commit). The `.tmp.*` names are the scratch dirs the generator swaps
# from; they live on the same filesystem as the corpus so the final move is a rename.
/jals-tests/sources/openjdk-gjf
/jals-tests/sources/openjdk-palantir
/jals-tests/sources/openjdk-eclipse
/jals-tests/sources/openjdk-intellij
/jals-tests/sources/openjdk-*.tmp.*
# The generated compiler corpus: OpenJDK's own javac tests plus the class files javac
# produced from them — GPL derivatives and binaries both, so likewise never committed.
/jals-tests/sources/javac-langtools
/jals-tests/sources/javac-langtools.tmp.*
# Locally fetched reference formatters and the compiled Eclipse driver (binaries — never
# commit).
/jals-tests/vendor
google-java-format-*.jar
# Byte cache from the one Python generator in the tree (`examples/scripts/`). Running it is a
# documented step, and it should not leave anything for the next `git add -A` to pick up.
__pycache__/
